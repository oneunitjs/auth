# Copy this file to `.env` and fill in real values locally.
# Never commit real secrets. All values here are placeholder names only.

OIDC_CLIENT_ID=replace-with-your-client-id
OIDC_CLIENT_SECRET=replace-with-your-client-secret
OIDC_CALLBACK_URL=http://localhost:3000/auth/callback

DATABASE_URL=replace-with-your-database-url
REDIS_URL=replace-with-your-redis-url

AUTH_SECRET=replace-with-a-high-entropy-signing-secret
REFRESH_SECRET=replace-with-a-distinct-refresh-signing-secret
